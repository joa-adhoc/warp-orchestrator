#!/usr/bin/env bash
# Start the coordinator: Claude with the warp-orchestrator agent, named ORCHESTRATOR_NAME (config).
#   warp-orchestrator          run it in this terminal (the tab gets the name, not the color)
#   warp-orchestrator --tab    open it in a new tab, also colored ORCHESTRATOR_COLOR, and switch to it
# Other arguments go to claude.
set -euo pipefail
# The other warp-* tools live next to this script, outside the PATH.
PATH="$(dirname "$(readlink -f "$0")"):$PATH"

ORCHESTRATOR_NAME=Orchestrator
ORCHESTRATOR_COLOR=yellow
config="${XDG_CONFIG_HOME:-$HOME/.config}/warp-orchestrator/config"
# shellcheck source=/dev/null
[ -f "$config" ] && . "$config"

if [ "${1:-}" = --tab ]; then
  exec warp-tab --focus --agent warp-orchestrator -c "$ORCHESTRATOR_COLOR" -d "$PWD" "$ORCHESTRATOR_NAME::"
fi
exec claude --agent warp-orchestrator --name "$ORCHESTRATOR_NAME" "$@"
