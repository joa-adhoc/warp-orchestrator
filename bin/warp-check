#!/usr/bin/env bash
# Exit 0 when this shell can open Warp tabs. Otherwise print one reason per line and exit 1.
# Also prints the tab_configs dir and URI scheme on success, as "key=value" lines.
set -u
# The other warp-* tools live next to this script, outside the PATH.
PATH="$(dirname "$(readlink -f "$0")"):$PATH"

reasons=()
[ "$(uname -s)" = Linux ] || reasons+=("not-linux: $(uname -s)")
[ "${TERM_PROGRAM:-}" = WarpTerminal ] || reasons+=("not-warp: TERM_PROGRAM=${TERM_PROGRAM:-unset}")
command -v xdg-open >/dev/null || reasons+=("missing: xdg-open")

if [[ "${WARP_CLIENT_VERSION:-}" == *preview* ]]; then
  dir="${XDG_DATA_HOME:-$HOME/.local/share}/warp-terminal-preview/tab_configs"
  scheme="warppreview"
else
  dir="${XDG_DATA_HOME:-$HOME/.local/share}/warp-terminal/tab_configs"
  scheme="warp"
fi

if [ ${#reasons[@]} -gt 0 ]; then
  printf '%s\n' "${reasons[@]}"
  exit 1
fi
echo "tab_configs=$dir"
echo "scheme=$scheme"

# Not fatal: without a live shortcut, new groups are not created (open groups are still joined).
# A missing shortcut is bound to the default key when that key is free.
GROUP_MODE=keys
config="${XDG_CONFIG_HOME:-$HOME/.config}/warp-orchestrator/config"
# shellcheck source=/dev/null
[ -f "$config" ] && . "$config"
if [ "$GROUP_MODE" = keys ]; then
  if ! command -v xdotool >/dev/null; then
    echo "shortcut=no-xdotool"
  else
    shortcut="$(warp-shortcut)"
    [ "$shortcut" != missing ] || shortcut="$(warp-shortcut install)"
    echo "shortcut=$shortcut"
  fi
fi
