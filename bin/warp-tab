#!/usr/bin/env bash
# Open one Warp tab per spec, each running an agent CLI. See usage below.
set -euo pipefail
# The other warp-* tools live next to this script, outside the PATH.
PATH="$(dirname "$(readlink -f "$0")"):$PATH"

usage() {
  cat <<'EOF'
usage: warp-tab [-d DIR] [-a claude|codex|gemini] [-g GROUP [--keys|--inherit]] [-c COLOR] [-r SESSION_ID]... [--agent NAME] [--focus] [--dry-run] ["NAME::PROMPT" ...]

  -d DIR         working directory of the new tabs (default: current dir)
  -a RUNTIME     agent CLI to run (default: claude)
  -g GROUP       group label, saved in the registry. If a Warp group with that name (or the same
                 leading task id) is open, the tabs join it. Otherwise, in the current window the
                 tabs get GROUP's color and join the Warp group of the active tab, if it has one
  -c COLOR       tab or group color: red green yellow blue magenta cyan (default: a color no open
                 group uses, or the open group's color)
  --keys         with -g and 2+ specs, create a native group named GROUP in the current window
                 (the default): xdotool (X11) presses the Warp shortcut of "Create tab group from
                 active or selected tab(s)" (see warp-shortcut) and types the name. Takes over the
                 keyboard for a few seconds; if Warp loses the focus or the shortcut is not live,
                 the group is not created
  --agent NAME   start Claude with --agent NAME (claude only)
  -r SESSION_ID  resume that session instead of starting a new one. Repeat it to resume several:
                 the Nth -r goes with the Nth spec (with no specs, one empty spec per -r)
  --inherit      with -g, no native group: color only, and the tabs join the active tab's group
  --focus        stay on the last new tab (default: go back to the tab that ran warp-tab)
  --dry-run      print the tab configs instead of opening them

No spec opens one empty session. A spec is "NAME::PROMPT"; either side may be empty.
Names that start with a task id ("78420 Skill encarar: borrador ...") are shortened with warp-name.
EOF
}

dir="$PWD"; runtime=claude; group=""; color=""; resumes=(); dry=0; focus=0; palette=0; inherit=0
agent=""
while [ $# -gt 0 ]; do
  case "$1" in
    --focus) focus=1; shift ;;
    --keys) palette=1; shift ;;
    --agent) agent="$2"; shift 2 ;;
    -d) dir="$2"; shift 2 ;;
    -a) runtime="$2"; shift 2 ;;
    -g) group="$2"; shift 2 ;;
    -c) color="$2"; shift 2 ;;
    -r) resumes+=("$2"); shift 2 ;;
    --inherit) inherit=1; shift ;;
    --dry-run) dry=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
    *) break ;;
  esac
done
specs=("$@")
if [ ${#specs[@]} -eq 0 ]; then
  if [ ${#resumes[@]} -gt 0 ]; then
    for _ in "${resumes[@]}"; do specs+=("::"); done
  else
    specs=("::")
  fi
fi

# With -g and 2+ tabs, how the group is made: the flag wins, then GROUP_MODE in the config.
config_file="${XDG_CONFIG_HOME:-$HOME/.config}/warp-orchestrator/config"
GROUP_MODE=keys
START_GAP=4
# shellcheck source=/dev/null
[ -f "$config_file" ] && . "$config_file"
if [ "$palette" = 0 ] && [ "$inherit" = 0 ] && [ "$GROUP_MODE" = keys ]; then
  palette=1
fi
if [ "$palette" = 1 ] && ! command -v xdotool >/dev/null; then
  echo "warp-tab: --keys needs xdotool (X11); opening without a native group" >&2
  palette=0
fi

case "$runtime" in claude|codex|gemini) ;; *) echo "unknown runtime: $runtime" >&2; exit 2 ;; esac
if [ ${#resumes[@]} -gt 0 ] && [ ${#resumes[@]} -ne ${#specs[@]} ]; then
  echo "give one spec per -r (or no specs)" >&2; exit 2
fi
if [ "$runtime" = gemini ] && [ ${#resumes[@]} -gt 0 ]; then
  echo "resume is not supported for gemini (it resumes by per-project index, not by id)" >&2; exit 2
fi
command -v "$runtime" >/dev/null || { echo "missing: $runtime" >&2; exit 1; }
dir="$(cd "$dir" && pwd)"

if ! check="$(warp-check)"; then
  [ "$dry" = 1 ] || { echo "$check" >&2; exit 1; }
  check="tab_configs=/dev/null
scheme=warp"
fi
config_dir="$(sed -n 's/^tab_configs=//p' <<<"$check")"
scheme="$(sed -n 's/^scheme=//p' <<<"$check")"

if [[ "$group" =~ ^[0-9]+\  ]] && [ ${#group} -gt 20 ]; then
  group="$(warp-name --group "${group%% *}" "${group#* }")"
fi

# A group already open in Warp is joined: its last tab comes to the front and the new tabs land
# next to it, inheriting the group and its color. No keys are pressed.
join_url=""
if [ -n "$group" ] && live="$(warp-groups --find "$group" 2>/dev/null)"; then
  IFS=$'\t' read -r _ live_name live_color _ _ join_url <<<"$live"
  [ "$join_url" != - ] || join_url=""
  if [ -n "$join_url" ]; then
    group="$live_name"
    [ -n "$color" ] || [ "$live_color" = - ] || color="$live_color"
    palette=0
  fi
fi

# A new group takes a color that no open Warp group uses, never the coordinator's. groups.json
# remembers it, so a group closed and opened again gets the same color while it is free.
ORCHESTRATOR_COLOR="${ORCHESTRATOR_COLOR:-yellow}"
groups_file="${XDG_STATE_HOME:-$HOME/.local/state}/warp-orchestrator/groups.json"
remember_color() {
  python3 -I - "$groups_file" "$1" "$2" <<'PY'
import json, os, sys
path, group, color = sys.argv[1:]
try:
    with open(path) as f:
        groups = json.load(f)
except (OSError, ValueError):
    groups = {}
groups[group] = color
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "w") as f:
    json.dump(groups, f, ensure_ascii=False, indent=2)
PY
}
if [ -z "$color" ] && [ -n "$group" ]; then
  color="$(python3 -I - "$groups_file" "$group" "$ORCHESTRATOR_COLOR" "$(warp-groups --colors 2>/dev/null | tr '\n' ' ')" <<'PY'
import json, sys
path, group, reserved, live = sys.argv[1:]
palette = [c for c in ("red", "green", "blue", "magenta", "cyan", "yellow") if c != reserved]
live = live.split()
try:
    with open(path) as f:
        groups = json.load(f)
except (OSError, ValueError):
    groups = {}
color = groups.get(group)
if color not in palette or color in live:
    color = min(palette, key=lambda c: (live.count(c), palette.index(c)))
print(color)
PY
)"
  [ "$dry" = 1 ] || remember_color "$group" "$color"
fi

toml_str() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  printf '"%s"' "$s"
}

agent_cmd() {
  local name="$1" prompt="$2" sid="$3" resume="$4" args=()
  case "$runtime" in
    claude)
      args=(claude)
      if [ -n "$resume" ]; then args+=(--resume "$resume"); else args+=(--session-id "$sid"); fi
      [ -z "$agent" ] || args+=(--agent "$agent")
      [ -z "$name" ] || args+=(--name "$name")
      [ -z "$prompt" ] || args+=("$prompt")
      ;;
    codex)
      if [ -n "$resume" ]; then args=(codex resume "$resume"); else args=(codex); fi
      [ -z "$prompt" ] || args+=("$prompt")
      ;;
    gemini)
      args=(gemini)
      [ -z "$prompt" ] || args+=(-i "$prompt")
      ;;
  esac
  local out
  printf -v out '%q ' "${args[@]}"
  printf '%s' "${out% }"
}

warp_focused() {
  local pid
  pid="$(xdotool getactivewindow getwindowpid 2>/dev/null)" || return 1
  [[ "$(ps -o comm= -p "$pid")" == warp* ]]
}

press() {
  warp_focused || return 1
  xdotool "$@"
}

# A warp:// link opens the tab but the window manager may not raise Warp when another app has the
# focus. Prefer the window asking for attention (the one the link went to), else the first one.
raise_warp() {
  local w target=""
  for w in $(xdotool search --classname dev.warp.Warp 2>/dev/null); do
    [ -n "$target" ] || target="$w"
    if xprop -id "$w" _NET_WM_STATE 2>/dev/null | grep -q DEMANDS_ATTENTION; then target="$w"; break; fi
  done
  [ -z "$target" ] || xdotool windowactivate --sync "$target" 2>/dev/null || true
}

# Wait until the new tab shows the agent's title instead of the shell's.
wait_tab_ready() {
  local title
  for _ in $(seq 1 50); do
    title="$(xdotool getactivewindow getwindowname 2>/dev/null || true)"
    case "$title" in bash*|"New session"|"") sleep 0.2 ;; *) sleep 0.5; return 0 ;; esac
  done
}

# Group the active tab with the shortcut, then name the group in the rename modal Warp opens right
# after creating it (WorkspaceAction::RenameTabGroup).
palette_group() {
  local key
  # A shortcut, never Warp's command palette: a slow filter there can pick a file and the group
  # name lands inside it. If the shortcut is not live, the name would land in the new tab's prompt.
  if ! key="$(warp-shortcut xdotool)"; then
    echo "warp-tab: the group shortcut is $(warp-shortcut); run warp-shortcut --help" >&2
    return 1
  fi
  command -v xclip >/dev/null || { echo "warp-tab: naming a new group needs xclip" >&2; return 1; }
  wait_tab_ready
  warp_focused || raise_warp
  press key "$key" || return 1
  sleep 0.8
  paste_text "$1" || return 1
  sleep 0.3
  press key Return || return 1
  sleep 0.5
}

# Paste instead of `xdotool type`: with several keyboard layouts, xdotool remaps a key for each
# character and GNOME reloads every shortcut on each remap, which freezes the whole desktop.
# The user's text clipboard is put back afterwards.
paste_text() {
  local old="" had=0 rc=0
  old="$(xclip -selection clipboard -o 2>/dev/null)" && had=1
  printf '%s' "$1" | xclip -selection clipboard
  sleep 0.1
  press key ctrl+v || rc=1
  sleep 0.3
  if [ "$had" = 1 ]; then printf '%s' "$old" | xclip -selection clipboard; fi
  return "$rc"
}

if [ -n "$agent" ] && [ "$runtime" != claude ]; then
  echo "--agent is for claude only" >&2; exit 2
fi
# Each warp:// link brings Warp to the front. Remember where the user was, to go back there at the end.
prev_win=""
if [ "$dry" = 0 ] && command -v xdotool >/dev/null; then
  prev_win="$(xdotool getactivewindow 2>/dev/null || true)"
fi

# New tabs land after the active tab and the group is made from the first new one, so start from
# the coordinator's tab with its window in front.
if [ -n "$join_url" ] && [ "$dry" = 1 ]; then
  echo "# join the open group '$group': $join_url"
elif [ -n "$join_url" ]; then
  xdg-open "$join_url" >/dev/null 2>&1
  sleep 0.8
elif [ "$palette" = 1 ] && [ "$dry" = 0 ]; then
  if [ -n "${WARP_FOCUS_URL:-}" ]; then
    xdg-open "$WARP_FOCUS_URL" >/dev/null 2>&1
    sleep 0.8
  fi
  raise_warp
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/warp-orchestrator"
launch_dir="$state_dir/launch"
mkdir -p "$state_dir" "$launch_dir"
[ "$dry" = 1 ] || mkdir -p "$config_dir"

register() {
  python3 -I - "$state_dir/sessions.jsonl" "$runtime" "$1" "$2" "$group" "$color" "$dir" "$3" "$4" <<'PY'
import json, sys, time
path, runtime, sid, name, group, color, cwd, prompt, resume = sys.argv[1:]
row = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "runtime": runtime, "session_id": sid or None,
       "name": name, "group": group or None, "color": color or None, "cwd": cwd,
       "prompt": prompt[:200], "resumed": bool(resume)}
with open(path, "a") as f:
    f.write(json.dumps(row, ensure_ascii=False) + "\n")
PY
  echo "opened: ${2:-<empty>} (${runtime}${1:+ $1})"
}

names=(); sids=(); prompts=(); launchers=(); rids=()
for idx in "${!specs[@]}"; do
  spec="${specs[$idx]}"
  resume="${resumes[$idx]:-}"
  name="${spec%%::*}"; prompt=""
  [[ "$spec" == *::* ]] && prompt="${spec#*::}"
  if [[ "$name" =~ ^[0-9]+\  ]] && [ ${#name} -gt 32 ]; then
    name="$(warp-name "${name%% *}" "${name#* }")"
  fi
  sid="$resume"
  if [ "$runtime" = claude ] && [ -z "$sid" ]; then sid="$(cat /proc/sys/kernel/random/uuid)"; fi

  # Warp types the command into the new tab, so a keystroke there can land at its end. The tab runs
  # a short launcher that ignores its arguments; the real command, with its quoting, lives inside.
  launcher="$launch_dir/warp_orchestrator_$(date +%s%N).sh"
  script=$'#!/usr/bin/env bash\nrm -f -- "$0"\n'
  # Agents starting together (each with its MCP servers) can stall the machine: start one every
  # START_GAP seconds. The tabs themselves open at once.
  [ "$idx" = 0 ] || [ "$START_GAP" = 0 ] || script+="sleep $((idx * START_GAP))"$'\n'
  script+="exec $(agent_cmd "$name" "$prompt" "$sid" "$resume")"$'\n'
  if [ "$dry" = 1 ]; then
    echo "# $launcher"
    echo "$script"
  else
    printf '%s' "$script" > "$launcher"
  fi
  names+=("$name"); sids+=("$sid"); prompts+=("$prompt"); launchers+=("$launcher"); rids+=("$resume")
done

stems=()
for i in "${!names[@]}"; do
  name="${names[$i]}"
  stem="warp_orchestrator_$(date +%s%N)"
  stems+=("$stem")
  toml="name = $(toml_str "${name:-$runtime}")"$'\n'
  # A fixed title wins over the terminal title, so Claude (which titles the tab from --name) and
  # the ✅/🔔 marks of hooks/agent-event would never show. Other runtimes get the fixed title.
  if [ -n "$name" ] && [ "$runtime" != claude ]; then
    toml+="title = $(toml_str "$name")"$'\n'
  fi
  [ -z "$color" ] || toml+="color = $(toml_str "$color")"$'\n'
  toml+=$'\n[[panes]]\nid = "agent"\ntype = "terminal"\n'
  toml+="directory = $(toml_str "$dir")"$'\n'
  toml+="commands = [$(toml_str "bash ${launchers[$i]}")]"$'\n'
  if [ "$dry" = 1 ]; then
    echo "# $config_dir/$stem.toml → $scheme://tab_config/$stem"
    echo "$toml"
    continue
  fi
  printf '%s' "$toml" > "$config_dir/$stem.toml"
  # The config only has to live until Warp reads it; otherwise it piles up in the "+" menu.
  (sleep 20; rm -f "$config_dir/$stem.toml") >/dev/null 2>&1 &
  disown
done

[ "$dry" = 1 ] && exit 0

# Warp picks up new tab configs with a file watcher: one pause for all of them, then the links.
sleep 1
opened=0
for i in "${!names[@]}"; do
  [ "$i" = 0 ] || sleep 0.5
  xdg-open "$scheme://tab_config/${stems[$i]}" >/dev/null 2>&1
  register "${sids[$i]}" "${names[$i]}" "${prompts[$i]}" "${rids[$i]}"
  opened=$((opened + 1))
  # The next tabs land after the active one and inherit its group, so grouping the first is enough.
  if [ "$i" = 0 ] && [ "$palette" = 1 ] && [ -n "$group" ] && [ ${#names[@]} -ge 2 ]; then
    if palette_group "$group"; then
      sleep 1
      warp-groups --find "$group" >/dev/null 2>&1 ||
        echo "warp-tab: Warp shows no group named '$group' yet; a key pressed meanwhile may have changed its name" >&2
    else
      echo "warp-tab: the group was not created" >&2
    fi
  fi
done

# Back to where the user was: the coordinator's tab, or another app.
if [ "$focus" = 0 ]; then
  sleep 0.5
  if [ -n "$prev_win" ] && ! [[ "$(ps -o comm= -p "$(xdotool getwindowpid "$prev_win" 2>/dev/null)" 2>/dev/null)" == warp* ]]; then
    xdotool windowactivate "$prev_win" 2>/dev/null || true
  elif [ -n "${WARP_FOCUS_URL:-}" ]; then
    # Warp sets WARP_FOCUS_URL in every session; opening it brings that tab back to the front.
    xdg-open "$WARP_FOCUS_URL" >/dev/null 2>&1
  fi
fi

echo "total: $opened${group:+, group: $group}${join_url:+ (joined)}${color:+, color: $color}"
