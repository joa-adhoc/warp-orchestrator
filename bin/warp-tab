#!/usr/bin/env bash
# Open one Warp tab per spec, each running an agent CLI. See usage below.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: warp-tab [-d DIR] [-a claude|codex|gemini] [-g GROUP [--keys|--window|--inherit]] [-c COLOR] [-r SESSION_ID]... [--agent NAME] [--focus] [--dry-run] ["NAME::PROMPT" ...]

  -d DIR         working directory of the new tabs (default: current dir)
  -a RUNTIME     agent CLI to run (default: claude)
  -g GROUP       group label, saved in the registry. In the current window the tabs get GROUP's
                 color and join the Warp group of the active tab, if it has one
  -c COLOR       tab or group color: red green yellow blue magenta cyan (default: derived from GROUP)
  --window       with -g and 2+ specs, open them in a new Warp window as a native group named GROUP
  --keys         with -g and 2+ specs, create a native group named GROUP in the current window:
                 xdotool (X11) presses the Warp shortcut of "Create tab group from active or
                 selected tab(s)" and types the name. Takes over the keyboard for a few seconds;
                 if Warp loses the focus or has no shortcut for it, the group is not created
  --agent NAME   start Claude with --agent NAME (claude only)
  -r SESSION_ID  resume that session instead of starting a new one. Repeat it to resume several:
                 the Nth -r goes with the Nth spec (with no specs, one empty spec per -r)
  --inherit      with -g, no native group: color only, and the tabs join the active tab's group
  --focus        stay on the last new tab (default: go back to the tab that ran warp-tab)
  --dry-run      print the tab configs instead of opening them

No spec opens one empty session. A spec is "NAME::PROMPT"; either side may be empty.
Names that start with a task id ("78420 Skill encarar: borrador ...") are shortened with warp-name.
EOF
}

dir="$PWD"; runtime=claude; group=""; color=""; resumes=(); dry=0; focus=0; new_window=0; palette=0; inherit=0
agent=""
while [ $# -gt 0 ]; do
  case "$1" in
    --focus) focus=1; shift ;;
    --keys) palette=1; shift ;;
    --agent) agent="$2"; shift 2 ;;
    --window) new_window=1; shift ;;
    -d) dir="$2"; shift 2 ;;
    -a) runtime="$2"; shift 2 ;;
    -g) group="$2"; shift 2 ;;
    -c) color="$2"; shift 2 ;;
    -r) resumes+=("$2"); shift 2 ;;
    --inherit) inherit=1; shift ;;
    --dry-run) dry=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
    *) break ;;
  esac
done
specs=("$@")
if [ ${#specs[@]} -eq 0 ]; then
  if [ ${#resumes[@]} -gt 0 ]; then
    for _ in "${resumes[@]}"; do specs+=("::"); done
  else
    specs=("::")
  fi
fi

# With -g and 2+ tabs, how the group is made: the flag wins, then GROUP_MODE in the config.
config_file="${XDG_CONFIG_HOME:-$HOME/.config}/warp-orchestrator/config"
GROUP_MODE=inherit
# shellcheck source=/dev/null
[ -f "$config_file" ] && . "$config_file"
if [ "$palette" = 0 ] && [ "$new_window" = 0 ] && [ "$inherit" = 0 ]; then
  case "$GROUP_MODE" in keys) palette=1 ;; window) new_window=1 ;; esac
fi
if [ "$palette" = 1 ] && ! command -v xdotool >/dev/null; then
  echo "warp-tab: --keys needs xdotool (X11); opening without a native group" >&2
  palette=0
fi

case "$runtime" in claude|codex|gemini) ;; *) echo "unknown runtime: $runtime" >&2; exit 2 ;; esac
if [ ${#resumes[@]} -gt 0 ] && [ ${#resumes[@]} -ne ${#specs[@]} ]; then
  echo "give one spec per -r (or no specs)" >&2; exit 2
fi
if [ "$runtime" = gemini ] && [ ${#resumes[@]} -gt 0 ]; then
  echo "resume is not supported for gemini (it resumes by per-project index, not by id)" >&2; exit 2
fi
command -v "$runtime" >/dev/null || { echo "missing: $runtime" >&2; exit 1; }
dir="$(cd "$dir" && pwd)"

if ! check="$(warp-check)"; then
  [ "$dry" = 1 ] || { echo "$check" >&2; exit 1; }
  check="tab_configs=/dev/null
scheme=warp"
fi
config_dir="$(sed -n 's/^tab_configs=//p' <<<"$check")"
scheme="$(sed -n 's/^scheme=//p' <<<"$check")"

colors=(red green yellow blue magenta cyan)
if [ -z "$color" ] && [ -n "$group" ]; then
  color="${colors[$(( $(cksum <<<"$group" | cut -d' ' -f1) % ${#colors[@]} ))]}"
fi
if [[ "$group" =~ ^UM\ [0-9]+\  ]] && [ ${#group} -gt 40 ]; then
  group="$(warp-name --group "$(cut -d' ' -f2 <<<"$group")" "$(cut -d' ' -f4- <<<"$group")")"
fi

toml_str() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  printf '"%s"' "$s"
}

agent_cmd() {
  local name="$1" prompt="$2" sid="$3" resume="$4" args=()
  case "$runtime" in
    claude)
      args=(claude)
      if [ -n "$resume" ]; then args+=(--resume "$resume"); else args+=(--session-id "$sid"); fi
      [ -z "$agent" ] || args+=(--agent "$agent")
      [ -z "$name" ] || args+=(--name "$name")
      [ -z "$prompt" ] || args+=("$prompt")
      ;;
    codex)
      if [ -n "$resume" ]; then args=(codex resume "$resume"); else args=(codex); fi
      [ -z "$prompt" ] || args+=("$prompt")
      ;;
    gemini)
      args=(gemini)
      [ -z "$prompt" ] || args+=(-i "$prompt")
      ;;
  esac
  local out
  printf -v out '%q ' "${args[@]}"
  printf '%s' "${out% }"
}

warp_focused() {
  local pid
  pid="$(xdotool getactivewindow getwindowpid 2>/dev/null)" || return 1
  [[ "$(ps -o comm= -p "$pid")" == warp* ]]
}

press() {
  warp_focused || return 1
  xdotool "$@"
}

# A warp:// link opens the tab but the window manager may not raise Warp when another app has the
# focus. Prefer the window asking for attention (the one the link went to), else the first one.
raise_warp() {
  local w target=""
  for w in $(xdotool search --classname dev.warp.Warp 2>/dev/null); do
    [ -n "$target" ] || target="$w"
    if xprop -id "$w" _NET_WM_STATE 2>/dev/null | grep -q DEMANDS_ATTENTION; then target="$w"; break; fi
  done
  [ -z "$target" ] || xdotool windowactivate --sync "$target" 2>/dev/null || true
}

# Wait until the new tab shows the agent's title instead of the shell's.
wait_tab_ready() {
  local title
  for _ in $(seq 1 50); do
    title="$(xdotool getactivewindow getwindowname 2>/dev/null || true)"
    case "$title" in bash*|"New session"|"") sleep 0.2 ;; *) sleep 0.5; return 0 ;; esac
  done
}

# The xdotool form of the Warp shortcut bound to the group action, from the user's keybindings.
# gr's claude-tab searched the command palette instead, but a slow filter can pick another entry
# (a file, for example) and the group name then lands inside it. A shortcut runs only this action.
group_key() {
  local file="${XDG_CONFIG_HOME:-$HOME/.config}/warp-terminal/keybindings.yaml" raw
  [ -f "$file" ] || return 1
  raw="$(sed -n 's/^[[:space:]]*"\{0,1\}workspace:new_tab_group_from_active_or_selected_tabs"\{0,1\}:[[:space:]]*//p' "$file" \
    | tr -d "\"' " | head -1)"
  [ -n "$raw" ] && [ "$raw" != none ] || return 1
  python3 -I - "$raw" <<'KEY'
import sys
parts = sys.argv[1].split("-")
mods = {"ctrl": "ctrl", "alt": "alt", "shift": "shift", "cmd": "super", "meta": "super", "super": "super"}
keys = [mods[p.lower()] for p in parts[:-1] if p.lower() in mods]
last = parts[-1]
if len(last) == 1 and last.isalpha():
    if last.isupper() and "shift" not in keys:
        keys.append("shift")
    last = last.lower()
print("+".join(keys + [last]))
KEY
}

# Group the active tab with the shortcut, then name the group in the rename modal Warp opens right
# after creating it (WorkspaceAction::RenameTabGroup).
palette_group() {
  local key
  key="$(group_key)" || {
    echo "warp-tab: Warp has no shortcut for 'Create tab group from active or selected tab(s)'; set one in Settings > Keyboard shortcuts" >&2
    return 1
  }
  wait_tab_ready
  warp_focused || raise_warp
  press key "$key" || return 1
  sleep 0.8
  press type --delay 30 "$1" || return 1
  sleep 0.5
  press key Return || return 1
  sleep 0.5
}

if [ -n "$agent" ] && [ "$runtime" != claude ]; then
  echo "--agent is for claude only" >&2; exit 2
fi
# New tabs land after the active tab and the group is made from the first new one, so start from
# the coordinator's tab with its window in front.
if [ "$palette" = 1 ] && [ "$dry" = 0 ]; then
  if [ -n "${WARP_FOCUS_URL:-}" ]; then
    xdg-open "$WARP_FOCUS_URL" >/dev/null 2>&1
    sleep 0.8
  fi
  raise_warp
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/warp-orchestrator"
launch_dir="$state_dir/launch"
mkdir -p "$state_dir" "$launch_dir"
[ "$dry" = 1 ] || mkdir -p "$config_dir"

register() {
  python3 -I - "$state_dir/sessions.jsonl" "$runtime" "$1" "$2" "$group" "$color" "$dir" "$3" "$4" <<'PY'
import json, sys, time
path, runtime, sid, name, group, color, cwd, prompt, resume = sys.argv[1:]
row = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "runtime": runtime, "session_id": sid or None,
       "name": name, "group": group or None, "color": color or None, "cwd": cwd,
       "prompt": prompt[:200], "resumed": bool(resume)}
with open(path, "a") as f:
    f.write(json.dumps(row, ensure_ascii=False) + "\n")
PY
  echo "opened: ${2:-<empty>} (${runtime}${1:+ $1})"
}

# Warp creates tab groups only from its UI or from a launch config, and a launch config link always
# opens a new window. In the current window, new tabs land after the active tab and inherit its group.
window_mode=0
[ -n "$group" ] && [ ${#specs[@]} -ge 2 ] && [ "$new_window" = 1 ] && window_mode=1
launch_configs_dir="$(dirname "$config_dir")/launch_configurations"
[ "$dry" = 1 ] || mkdir -p "$launch_configs_dir"

names=(); sids=(); prompts=(); launchers=(); rids=()
for idx in "${!specs[@]}"; do
  spec="${specs[$idx]}"
  resume="${resumes[$idx]:-}"
  name="${spec%%::*}"; prompt=""
  [[ "$spec" == *::* ]] && prompt="${spec#*::}"
  if [[ "$name" =~ ^[0-9]+\  ]] && [ ${#name} -gt 32 ]; then
    name="$(warp-name "${name%% *}" "${name#* }")"
  fi
  sid="$resume"
  if [ "$runtime" = claude ] && [ -z "$sid" ]; then sid="$(cat /proc/sys/kernel/random/uuid)"; fi

  # Warp types the command into the new tab, so a keystroke there can land at its end. The tab runs
  # a short launcher that ignores its arguments; the real command, with its quoting, lives inside.
  launcher="$launch_dir/warp_orchestrator_$(date +%s%N).sh"
  script=$'#!/usr/bin/env bash\nrm -f -- "$0"\nexec '"$(agent_cmd "$name" "$prompt" "$sid" "$resume")"$'\n'
  if [ "$dry" = 1 ]; then
    echo "# $launcher"
    echo "$script"
  else
    printf '%s' "$script" > "$launcher"
  fi
  names+=("$name"); sids+=("$sid"); prompts+=("$prompt"); launchers+=("$launcher"); rids+=("$resume")
done

opened=0
if [ "$window_mode" = 1 ]; then
  stem="warp_orchestrator_$(date +%s%N)"
  # YAML is a superset of JSON, so json.dumps gives a valid launch config with safe quoting.
  config="$(python3 -I - "$stem" "$dir" "$group" "$color" "$runtime" "${#names[@]}" "${names[@]}" "${launchers[@]}" <<'PY'
import json, sys
stem, cwd, group, color, runtime, count = sys.argv[1:7]
count = int(count)
names, launchers = sys.argv[7:7 + count], sys.argv[7 + count:]
tabs = []
for name, launcher in zip(names, launchers):
    tab = {"layout": {"cwd": cwd, "commands": [{"exec": f"bash {launcher}"}]}, "group": 0}
    # Claude titles the tab from --name; a fixed title would hide that and the hook marks.
    if name and runtime != "claude":
        tab["title"] = name
    tabs.append(tab)
group_entry = {"name": group}
if color:
    group_entry["color"] = color
print(json.dumps({"name": stem, "active_window_index": 0,
                  "windows": [{"active_tab_index": 0, "tabs": tabs, "tab_groups": [group_entry]}]},
                 ensure_ascii=False, indent=2))
PY
)"
  if [ "$dry" = 1 ]; then
    echo "# $launch_configs_dir/$stem.yaml → $scheme://launch/$stem"
    echo "$config"
    exit 0
  fi
  printf '%s\n' "$config" > "$launch_configs_dir/$stem.yaml"
  xdg-open "$scheme://launch/$stem" >/dev/null 2>&1
  (sleep 15; rm -f "$launch_configs_dir/$stem.yaml") >/dev/null 2>&1 &
  disown
  for i in "${!names[@]}"; do
    register "${sids[$i]}" "${names[$i]}" "${prompts[$i]}" "${rids[$i]}"
    opened=$((opened + 1))
  done
else
  for i in "${!names[@]}"; do
    name="${names[$i]}"
    stem="warp_orchestrator_$(date +%s%N)"
    toml="name = $(toml_str "${name:-$runtime}")"$'\n'
    # A fixed title wins over the terminal title, so Claude (which titles the tab from --name) and
    # the ✅/🔔 marks of hooks/agent-event would never show. Other runtimes get the fixed title.
    if [ -n "$name" ] && [ "$runtime" != claude ]; then
      toml+="title = $(toml_str "$name")"$'\n'
    fi
    [ -z "$color" ] || toml+="color = $(toml_str "$color")"$'\n'
    toml+=$'\n[[panes]]\nid = "agent"\ntype = "terminal"\n'
    toml+="directory = $(toml_str "$dir")"$'\n'
    toml+="commands = [$(toml_str "bash ${launchers[$i]}")]"$'\n'
    if [ "$dry" = 1 ]; then
      echo "# $config_dir/$stem.toml → $scheme://tab_config/$stem"
      echo "$toml"
      continue
    fi
    printf '%s' "$toml" > "$config_dir/$stem.toml"
    # Warp picks up new tab configs with a file watcher; give it a moment before the deeplink.
    sleep 1
    xdg-open "$scheme://tab_config/$stem" >/dev/null 2>&1
    # The config only has to live until Warp reads it; otherwise it piles up in the "+" menu.
    (sleep 15; rm -f "$config_dir/$stem.toml") >/dev/null 2>&1 &
    disown
    register "${sids[$i]}" "$name" "${prompts[$i]}" "${rids[$i]}"
    opened=$((opened + 1))
    # The next tabs land after the active one and inherit its group, so grouping the first is enough.
    if [ "$i" = 0 ] && [ "$palette" = 1 ] && [ -n "$group" ] && [ ${#names[@]} -ge 2 ]; then
      palette_group "$group" || echo "warp-tab: the group was not created" >&2
    fi
  done
fi

[ "$dry" = 1 ] && exit 0

if [ "$focus" = 0 ] && [ "$opened" -gt 0 ]; then
  sleep 1
  # Warp sets WARP_FOCUS_URL in every session; opening it brings that tab back to the front.
  if [ -n "${WARP_FOCUS_URL:-}" ]; then
    xdg-open "$WARP_FOCUS_URL" >/dev/null 2>&1
  fi
fi

echo "total: $opened${group:+, group: $group}${color:+, color: $color}"
